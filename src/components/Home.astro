---
import { Picture, getImage } from "astro:assets";

import Icon from "./Icon.astro";
import { captureLocale, messagesFor } from "../i18n";
import { currentRelease, megabytes } from "../lib/release";
import { REPOSITORY_GROUPS } from "../lib/repositories";
import { DESKTOP_DOC_URL, STRUCTURE_URL, UMBRELLA_URL, repositoryUrl } from "../lib/site";
import { HERO_SHOTS, SCREEN_SHOTS } from "../lib/shots";

import type { Locale } from "../i18n";
import type { ReleaseFile } from "../lib/release";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = messagesFor(locale);
const release = await currentRelease();
const files = release?.files ?? [];
const windowsFile = files.find((file) => file.platform === "windows");
const linuxFile = files.find((file) => file.platform === "linux" && file.format === "appimage") ?? files.find((file) => file.platform === "linux");
const released = release ? new Intl.DateTimeFormat(locale, { dateStyle: "long", timeZone: "UTC" }).format(new Date(release.date)) : "";
const formatName = (file: ReleaseFile): string => (file.format === "nsis" ? t.download.nsis : file.format === "deb" ? t.download.deb : t.download.appimage);
const platforms = [
  { name: t.download.windows, files: files.filter((file) => file.platform === "windows") },
  { name: t.download.linux, files: files.filter((file) => file.platform === "linux") },
].filter((platform) => platform.files.length > 0);
// The hero's shot: the console on a desktop, and the same room on a phone's screen below 600 pixels.
async function sources(src: ImageMetadata, widths: number[]) {
  const set = async (format: "avif" | "webp") => (await getImage({ src, widths, format, quality: 72 })).srcSet.attribute;

  return { avif: await set("avif"), webp: await set("webp") };
}

const capture = captureLocale(locale);
const roomShot = HERO_SHOTS[capture].wide;
const phoneShot = HERO_SHOTS[capture].phone;
const heroWide = await sources(roomShot, [720, 1080, 1440, 2160, 2880]);
const heroPhone = await sources(phoneShot, [390, 780]);
const heroFallback = await getImage({ src: roomShot, width: 1440, format: "webp", quality: 72 });
const PHONE_MEDIA = "(max-width: 599px)";
const SHOTS = SCREEN_SHOTS[capture];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="container hero-inner">
    <p class="eyebrow">{t.hero.eyebrow}</p>
    <h1 id="hero-title" class="hero-title">
      {t.hero.titleLines.map((line, index) => <span class:list={["hero-line", index === 1 && "hero-line-accent"]}>{line}</span>)}
    </h1>
    <p class="hero-sub">{t.hero.sub}</p>
    <div class="hero-actions">
      <a
        id="primary-download"
        class="button button-primary"
        href="#download"
        data-windows={windowsFile?.url}
        data-linux={linuxFile?.url}
        data-label-windows={t.hero.downloadWindows}
        data-label-linux={t.hero.downloadLinux}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11m-5-5 5 5 5-5M5 20h14" /></svg>
        <span id="primary-download-label">{t.hero.download}</span>
      </a>
      <a class="button button-ghost" href={UMBRELLA_URL}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.93c.58.1.79-.25.79-.56v-2c-3.2.69-3.88-1.37-3.88-1.37-.52-1.33-1.27-1.69-1.27-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.68 1.25 3.33.96.1-.75.4-1.25.72-1.54-2.55-.29-5.24-1.27-5.24-5.67 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.15 1.18a10.96 10.96 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.57.23 2.73.11 3.02.74.8 1.18 1.83 1.18 3.08 0 4.41-2.7 5.38-5.27 5.66.41.36.78 1.06.78 2.13v3.16c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z" /></svg>
        <span>{t.hero.source}</span>
      </a>
    </div>
    {release && <p class="hero-meta">v{release.version} · Windows · Linux</p>}
    <figure class="hero-shot">
      <div class="window">
        <div class="window-bar" aria-hidden="true"><span></span><span></span><span></span></div>
        <picture>
          <source media={PHONE_MEDIA} type="image/avif" srcset={heroPhone.avif} sizes="calc(100vw - 32px)" width={phoneShot.width} height={phoneShot.height} />
          <source media={PHONE_MEDIA} type="image/webp" srcset={heroPhone.webp} sizes="calc(100vw - 32px)" width={phoneShot.width} height={phoneShot.height} />
          <source type="image/avif" srcset={heroWide.avif} sizes="(max-width: 1200px) calc(100vw - 48px), 1168px" />
          <source type="image/webp" srcset={heroWide.webp} sizes="(max-width: 1200px) calc(100vw - 48px), 1168px" />
          <img src={heroFallback.src} width={roomShot.width} height={roomShot.height} alt={t.hero.shotAlt} loading="eager" fetchpriority="high" decoding="async" />
        </picture>
      </div>
      <figcaption>{t.hero.shotNote}</figcaption>
    </figure>
  </div>
</section>

<section class="values" aria-label={t.hero.eyebrow}>
  <div class="container values-grid">
    {
      t.values.map((value) => (
        <div class="value">
          <h2>{value.title}</h2>
          <p>{value.body}</p>
        </div>
      ))
    }
  </div>
</section>

<section id="how" class="section" aria-labelledby="how-title">
  <div class="container">
    <div class="section-head">
      <h2 id="how-title">{t.how.title}</h2>
      <p>{t.how.sub}</p>
    </div>
    <ol class="steps">
      {
        t.how.steps.map((step, index) => (
          <li class="step">
            <span class="step-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<section id="features" class="section" aria-labelledby="features-title">
  <div class="container">
    <div class="section-head">
      <h2 id="features-title">{t.features.title}</h2>
      <p>{t.features.sub}</p>
    </div>
    <ul class="features">
      {
        t.features.items.map((feature) => (
          <li class="feature">
            <span class="feature-icon"><Icon name={feature.icon} /></span>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section id="screens" class="section" aria-labelledby="screens-title">
  <div class="container">
    <div class="section-head">
      <h2 id="screens-title">{t.screens.title}</h2>
      <p>{t.screens.sub}</p>
    </div>
    <div class="screens">
      {
        t.screens.items.map((item) => (
          <figure class:list={["screen", `screen-${item.key}`]}>
            <div class="screen-frame">
              <Picture
                src={SHOTS[item.key as keyof typeof SHOTS]}
                formats={["avif", "webp"]}
                widths={item.key === "phone" ? [390, 780] : [640, 960, 1280, 1920]}
                sizes={item.key === "phone" ? "(max-width: 760px) 70vw, 300px" : "(max-width: 760px) calc(100vw - 32px), 560px"}
                alt={item.alt}
                loading="lazy"
                quality={72}
          fallbackFormat="webp"
              />
            </div>
            <figcaption>{item.caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<section id="download" class="section download" aria-labelledby="download-title">
  <div class="container download-inner">
    <div class="download-copy">
      <h2 id="download-title">{t.download.title}</h2>
      <p>{t.download.sub}</p>
      {
        release ? (
          <dl class="release-meta">
            <div>
              <dt>{t.download.version}</dt>
              <dd>{release.version}</dd>
            </div>
            <div>
              <dt>{t.download.released}</dt>
              <dd>
                <time datetime={release.date}>{released}</time>
              </dd>
            </div>
          </dl>
        ) : (
          <p class="release-missing">{t.download.unavailable}</p>
        )
      }
      <p class="download-note">{t.download.note}</p>
      <a class="text-link" href={DESKTOP_DOC_URL}>{t.download.docs} →</a>
    </div>
    <div class="download-files">
      {
        platforms.map((platform) => (
          <div class="platform">
            <h3>{platform.name}</h3>
            <ul>
              {platform.files.map((file) => (
                <li>
                  <a class="file" href={file.url} download>
                    <span class="file-name">{formatName(file)}</span>
                    <span class="file-meta">
                      {file.file} · {megabytes(file.size)}
                    </span>
                    <span class="file-sum" title={file.sha256}>
                      {t.download.checksum} {file.sha256.slice(0, 16)}…
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <div class="platform platform-source">
        <h3>{t.download.installTitle}</h3>
        <p>{t.download.installBody}</p>
        <a class="text-link" href={STRUCTURE_URL}>{t.download.installCta} →</a>
      </div>
    </div>
  </div>
</section>

<section id="repositories" class="section" aria-labelledby="repositories-title">
  <div class="container">
    <div class="section-head">
      <h2 id="repositories-title">{t.repositories.title}</h2>
      <p>{t.repositories.sub}</p>
    </div>
    <div class="repo-groups">
      {
        REPOSITORY_GROUPS.map((group) => (
          <div class="repo-group">
            <h3>{group.title[locale]}</h3>
            <ul>
              {group.items.map((repository) => (
                <li>
                  <a class="repo" href={repositoryUrl(repository.name)}>
                    <span class="repo-name">
                      {repository.name}
                      {repository.retired && <span class="tag">{t.repositories.retired}</span>}
                    </span>
                    <span class="repo-role">{repository.role[locale]}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section class="closing" aria-labelledby="closing-title">
  <div class="container closing-inner">
    <h2 id="closing-title">{t.closing.title}</h2>
    <p>{t.closing.sub}</p>
    <a class="button button-primary" href={UMBRELLA_URL}>{t.closing.cta}</a>
  </div>
</section>

<script is:inline>
  // Points the hero's download button at the installer for the visitor's system where one is published.
  (function () {
    var button = document.getElementById("primary-download");
    var label = document.getElementById("primary-download-label");
    if (!button || !label) return;
    var agent = navigator.userAgent;
    var mobile = /Android|iPhone|iPad/i.test(agent);
    var system = mobile ? null : /Windows/i.test(agent) ? "windows" : /Linux|X11/i.test(agent) ? "linux" : null;
    var href = system && button.getAttribute("data-" + system);
    if (!href) return;
    button.setAttribute("href", href);
    label.textContent = button.getAttribute("data-label-" + system);
  })();
</script>
