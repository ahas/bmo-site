---
import GetStarted from "./GetStarted.astro";
import Icon from "./Icon.astro";
import Shot from "./Shot.astro";
import { captureLocale, messagesFor } from "../i18n";
import { currentRelease, megabytes } from "../lib/release";
import { REPOSITORY_GROUPS } from "../lib/repositories";
import { DESKTOP_DOC_URL, UMBRELLA_URL, repositoryUrl } from "../lib/site";
import { EXAMPLES, KINDS, ROWS } from "../lib/comparison";
import { HERO_SHOTS, NEW_SHOTS, SCREEN_SHOTS, TOUR_SHOTS } from "../lib/shots";

import type { Locale } from "../i18n";
import type { ReleaseApp, ReleaseFile } from "../lib/release";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = messagesFor(locale);
const release = await currentRelease();
const released = release ? new Intl.DateTimeFormat(locale, { dateStyle: "long", timeZone: "UTC" }).format(new Date(release.date)) : "";
// A file's button word, by its platform and format: the Windows installer first, then Linux's AppImage and package.
const FORMAT_ORDER = ["windows-nsis", "linux-appimage", "linux-deb"] as const;
const formatKey = (file: ReleaseFile): string => `${file.platform}-${file.format}`;
const buttons = (app: ReleaseApp | undefined): { file: ReleaseFile; label: string }[] =>
  FORMAT_ORDER.flatMap((key) => (app?.files ?? []).filter((file) => formatKey(file) === key).map((file) => ({ file, label: t.download.formats[key] })));
// The two desktop apps, each with the files of the release and of the nightly build where one is published.
const apps = [
  { key: "remote", words: t.download.apps.remote, files: buttons(release ?? undefined), nightly: buttons(release?.nightly) },
  { key: "all-in-one", words: t.download.apps.allInOne, files: buttons(release?.allInOne), nightly: buttons(release?.nightly?.allInOne) },
];
const versionLine = release ? t.download.version.replace("{version}", release.version).replace("{date}", released) : "";
const nightlyLine = release?.nightly ? t.download.nightly.replace("{version}", release.nightly.version) : "";
const capture = captureLocale(locale);
const SHOTS = SCREEN_SHOTS[capture];
const TOUR = TOUR_SHOTS[capture];
const NEW = NEW_SHOTS[capture];
// The comparison's footnotes, numbered in the order their marks stand in the table.
const notes = ROWS.flatMap((row) => KINDS.filter((kind) => row.others[kind] === "partial").map((kind) => ({ key: `${row.capability}.${kind}` as keyof typeof t.compare.notes })));
const noteNumber = (key: string): number => notes.findIndex((note) => note.key === key) + 1;
// The marks as they are drawn: a partial mark is a shape of the stylesheet's, with no sign of its own.
const MARK_SIGN = { yes: "✓", partial: "", none: "–" } as const;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="container hero-inner">
    <p class="eyebrow">{t.hero.eyebrow}</p>
    <h1 id="hero-title" class="hero-title">
      {t.hero.titleLines.map((line, index) => <span class:list={["hero-line", index === 1 && "hero-line-accent"]}>{line}</span>)}
    </h1>
    <p class="hero-sub">{t.hero.sub}</p>
    <div class="hero-actions">
      <a id="primary-download" class="button button-primary" href="#download">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11m-5-5 5 5 5-5M5 20h14" /></svg>
        <span>{t.hero.download}</span>
      </a>
      <a class="button button-ghost" href={UMBRELLA_URL}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.93c.58.1.79-.25.79-.56v-2c-3.2.69-3.88-1.37-3.88-1.37-.52-1.33-1.27-1.69-1.27-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.68 1.25 3.33.96.1-.75.4-1.25.72-1.54-2.55-.29-5.24-1.27-5.24-5.67 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.15 1.18a10.96 10.96 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.57.23 2.73.11 3.02.74.8 1.18 1.83 1.18 3.08 0 4.41-2.7 5.38-5.27 5.66.41.36.78 1.06.78 2.13v3.16c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z" /></svg>
        <span>{t.hero.source}</span>
      </a>
    </div>
    {release && <p class="hero-meta">v{release.version} · Windows · Linux</p>}
    <figure class="hero-shot">
      <div class="window">
        <div class="window-bar" aria-hidden="true"><span></span><span></span><span></span></div>
        <Shot
          shot={HERO_SHOTS[capture].wide}
          widths={[720, 1080, 1440, 2160, 2880]}
          sizes="(max-width: 1200px) calc(100vw - 48px), 1168px"
          phone={{ shot: HERO_SHOTS[capture].phone, widths: [390, 780], sizes: "calc(100vw - 32px)" }}
          alt={t.hero.shotAlt}
          eager
        />
      </div>
      <figcaption>{t.hero.shotNote}</figcaption>
    </figure>
  </div>
</section>

<section class="values" aria-label={t.hero.eyebrow}>
  <div class="container values-grid">
    {
      t.values.map((value) => (
        <div class="value">
          <h2>{value.title}</h2>
          <p>{value.body}</p>
        </div>
      ))
    }
  </div>
</section>

<section id="new" class="section" aria-labelledby="new-title">
  <div class="container">
    <div class="section-head">
      <h2 id="new-title">{t.whatsNew.title}</h2>
      <p>{t.whatsNew.sub}</p>
    </div>
    <ul class="features news">
      {
        t.whatsNew.items.map((item) => (
          <li class="feature news-item">
            <span class="feature-icon"><Icon name={item.icon} /></span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))
      }
    </ul>
    <h3 class="tour-title">{t.whatsNew.shotsTitle}</h3>
    <p class="tour-sub">{t.whatsNew.shotsSub}</p>
    <div class="tour">
      {
        NEW.map((entry) => (
          <figure class="tour-shot">
            <div class="screen-frame">
              <Shot shot={entry.shot} widths={[640, 960, 1280, 1920]} sizes="(max-width: 899px) calc(100vw - 32px), 564px" alt={t.whatsNew.shots[entry.key].alt} />
            </div>
            <figcaption>
              <strong>{t.whatsNew.shots[entry.key].title}</strong> {t.whatsNew.shots[entry.key].caption}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<section id="how" class="section" aria-labelledby="how-title">
  <div class="container">
    <div class="section-head">
      <h2 id="how-title">{t.how.title}</h2>
      <p>{t.how.sub}</p>
    </div>
    <ol class="steps">
      {
        t.how.steps.map((step, index) => (
          <li class="step">
            <span class="step-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<section id="features" class="section" aria-labelledby="features-title">
  <div class="container">
    <div class="section-head">
      <h2 id="features-title">{t.features.title}</h2>
      <p>{t.features.sub}</p>
    </div>
    <ul class="features">
      {
        t.features.items.map((feature) => (
          <li class="feature">
            <span class="feature-icon"><Icon name={feature.icon} /></span>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section id="screens" class="section" aria-labelledby="screens-title">
  <div class="container">
    <div class="section-head">
      <h2 id="screens-title">{t.screens.title}</h2>
      <p>{t.screens.sub}</p>
    </div>
    <div class="screens">
      {
        t.screens.items.map((item) => (
          <figure class:list={["screen", `screen-${item.key}`]}>
            <div class="screen-frame">
              <Shot
                shot={SHOTS[item.key as keyof typeof SHOTS]}
                widths={item.key === "phone" ? [390, 780] : [640, 960, 1280, 1920]}
                sizes={item.key === "phone" ? "(max-width: 760px) 70vw, 300px" : "(max-width: 760px) calc(100vw - 32px), 560px"}
                alt={item.alt}
              />
            </div>
            <figcaption>{item.caption}</figcaption>
          </figure>
        ))
      }
    </div>
    <h3 class="tour-title">{t.tour.title}</h3>
    <p class="tour-sub">{t.tour.sub}</p>
    <div class="tour">
      {
        TOUR.map((entry) => (
          <figure class="tour-shot">
            <div class="screen-frame">
              <Shot shot={entry.shot} widths={[640, 960, 1280, 1920]} sizes="(max-width: 899px) calc(100vw - 32px), 564px" alt={t.tour.items[entry.key].alt} />
            </div>
            <figcaption>
              <strong>{t.tour.items[entry.key].title}</strong> {t.tour.items[entry.key].caption}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<section id="compare" class="section" aria-labelledby="compare-title">
  <div class="container">
    <div class="section-head">
      <h2 id="compare-title">{t.compare.title}</h2>
      <p>{t.compare.lead}</p>
    </div>
    <ul class="compare-legend">
      {
        (["yes", "partial", "none"] as const).map((mark) => (
          <li>
            <span class:list={["mark", `mark-${mark}`]} aria-hidden="true">{MARK_SIGN[mark]}</span>
            {t.compare.marks[mark]}
          </li>
        ))
      }
    </ul>
    <table class="compare">
      <thead>
        <tr>
          <th scope="col">{t.compare.capability}</th>
          <th scope="col" class="compare-bmo">{t.compare.bmo}</th>
          {
            KINDS.map((kind) => (
              <th scope="col">
                {t.compare.kinds[kind]}
                <span class="compare-examples">{EXAMPLES[kind]}</span>
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          ROWS.map((row) => (
            <tr>
              <th scope="row">{t.compare.rows[row.capability].title}</th>
              <td class="compare-bmo" data-kind={t.compare.bmo}>
                <span class="mark mark-yes" aria-hidden="true">✓</span>
                <span class="sr-only">{t.compare.marks.yes}: </span>
                <span class="compare-how">{t.compare.rows[row.capability].bmo}</span>
              </td>
              {KINDS.map((kind) => {
                const mark = row.others[kind];
                const number = mark === "partial" ? noteNumber(`${row.capability}.${kind}`) : 0;

                return (
                  <td data-kind={t.compare.kinds[kind]} data-mark={mark}>
                    <span class:list={["mark", `mark-${mark}`]} aria-hidden="true">{MARK_SIGN[mark]}</span>
                    <span class="mark-word">{t.compare.marks[mark]}</span>
                    {number > 0 && (
                      <a class="note-ref" href={`#compare-note-${number}`}>
                        <sup>{number}</sup>
                      </a>
                    )}
                  </td>
                );
              })}
            </tr>
          ))
        }
      </tbody>
    </table>
    <ol class="compare-notes">
      {
        notes.map((note, index) => (
          <li id={`compare-note-${index + 1}`}>{t.compare.notes[note.key]}</li>
        ))
      }
    </ol>
    <p class="compare-method">{t.compare.method}</p>
  </div>
</section>

<GetStarted locale={locale} />

<section id="download" class="section download" aria-labelledby="download-title">
  <div class="container download-inner">
    <div class="download-copy">
      <h2 id="download-title">{t.download.title}</h2>
      <p>{t.download.sub}</p>
      {release ? <p class="release-line">{versionLine}</p> : <p class="release-missing">{t.download.unavailable}</p>}
      {nightlyLine !== "" && <p class="release-nightly">{nightlyLine}</p>}
      <p class="download-note">{t.download.note}</p>
      <a class="text-link" href={DESKTOP_DOC_URL}>{t.download.docs} →</a>
    </div>
    <div class="download-files">
      {
        apps.map((app) => (
          <div class="desktop-app" data-app={app.key}>
            <h3>{app.words.name}</h3>
            <p>{app.words.body}</p>
            {app.files.length > 0 && (
              <ul>
                {app.files.map(({ file, label }) => (
                  <li>
                    <a class="file" href={file.url} download>
                      <span class="file-name">{label}</span>
                      <span class="file-meta">
                        {file.file} · {megabytes(file.size)}
                      </span>
                      <span class="file-sum" title={file.sha256}>
                        {t.download.checksum} {file.sha256.slice(0, 16)}…
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
            {app.nightly.length > 0 && (
              <ul class="nightly-files" aria-label={nightlyLine}>
                {app.nightly.map(({ file, label }) => (
                  <li>
                    <a class="file file-nightly" href={file.url} download>
                      <span class="file-name">
                        {label} · {nightlyLine}
                      </span>
                      <span class="file-meta">
                        {file.file} · {megabytes(file.size)}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>

<section id="repositories" class="section" aria-labelledby="repositories-title">
  <div class="container">
    <div class="section-head">
      <h2 id="repositories-title">{t.repositories.title}</h2>
      <p>{t.repositories.sub}</p>
    </div>
    <div class="repo-groups">
      {
        REPOSITORY_GROUPS.map((group) => (
          <div class="repo-group">
            <h3>{group.title[locale]}</h3>
            <ul>
              {group.items.map((repository) => (
                <li>
                  <a class="repo" href={repositoryUrl(repository.name)}>
                    <span class="repo-name">
                      {repository.name}
                      {repository.retired && <span class="tag">{t.repositories.retired}</span>}
                    </span>
                    <span class="repo-role">{repository.role[locale]}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section class="closing" aria-labelledby="closing-title">
  <div class="container closing-inner">
    <h2 id="closing-title">{t.closing.title}</h2>
    <p>{t.closing.sub}</p>
    <a class="button button-primary" href={UMBRELLA_URL}>{t.closing.cta}</a>
  </div>
</section>
