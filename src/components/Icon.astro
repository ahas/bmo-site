  brain: "M9 4a3 3 0 0 0-3 3 3 3 0 0 0-2 5 3 3 0 0 0 2 5 3 3 0 0 0 6 0V4.5A2.5 2.5 0 0 0 9 4zm6 0a3 3 0 0 1 3 3 3 3 0 0 1 2 5 3 3 0 0 1-2 5 3 3 0 0 1-6 0M12 8h-2m4 4h-2m2 4h-2",
  gate: "M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6zm-3 9l2 2 4-4",
  code: "M8 8l-4 4 4 4m8-8l4 4-4 4M14 5l-4 14",
  check: "M4 6h10M4 12h7M4 18h10m3-7l2 2 4-4",
  archive: "M4 4h16v4H4zm1 4v11h14V8M10 12h4",
