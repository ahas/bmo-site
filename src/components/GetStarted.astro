---
import { START } from "../i18n/start";
import { RUNBOOK_PAGE_URL } from "../lib/runbook";

import type { Locale } from "../i18n";

interface Props {
  locale: Locale;
}

// The get-started section: the one line a person hands their coding agent, which reads the install runbook at
// /install.md and carries the install out, and the three kinds of install the agent offers.
const { locale } = Astro.props;
const words = START[locale];
---

<section id="start" class="section" aria-labelledby="start-title">
  <div class="container">
    <div class="section-head">
      <h2 id="start-title">{words.title}</h2>
      <p>{words.sub}</p>
    </div>
    <figure class="start-line">
      <figcaption>{words.lineLabel}</figcaption>
      <pre><code>{words.line}</code></pre>
    </figure>
    <h3 class="start-presets-title">{words.presetsTitle}</h3>
    <ul class="start-presets">
      {
        words.presets.map((preset) => (
          <li>
            <strong>{preset.name}</strong>
            <span>{preset.body}</span>
          </li>
        ))
      }
    </ul>
    <a class="text-link" href={RUNBOOK_PAGE_URL}>{words.runbook} →</a>
  </div>
</section>

<style>
  .start-line {
    margin: 0 0 32px;
    max-width: 720px;
  }

  .start-line figcaption {
    color: var(--muted);
    font-size: 14.5px;
    margin-bottom: 8px;
  }

  .start-line pre {
    margin: 0;
    padding: 16px 18px;
    border: 1px solid var(--border-strong);
    border-radius: 12px;
    background: var(--bg);
    font-family: var(--mono);
    font-size: 15px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    user-select: all;
  }

  .start-presets-title {
    font-size: 18px;
    margin-bottom: 12px;
  }

  .start-presets {
    display: grid;
    gap: 12px;
    grid-template-columns: 1fr;
    list-style: none;
    margin: 0 0 24px;
    padding: 0;
  }

  .start-presets li {
    display: grid;
    gap: 4px;
    padding: 14px 16px;
    border: 1px solid var(--border-strong);
    border-radius: 12px;
  }

  .start-presets span {
    color: var(--muted);
    font-size: 14.5px;
  }

  @media (min-width: 900px) {
    .start-presets {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
