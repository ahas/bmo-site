---
import Layout from "../layouts/Layout.astro";
import { LOCALES, messagesFor } from "../i18n";

const en = messagesFor("en");
const languages = LOCALES.map((entry) => messagesFor(entry.code));
---

<Layout locale="en" title={`${en.notFound.title} — BMO`} noindex>
  <section class="section not-found">
    <div class="container">
      <h1>404</h1>
      <ul class="not-found-list">
        {
          languages.map((words) => (
            <li lang={words.htmlLang}>
              {words.notFound.body} <a href={words.path}>{words.notFound.home}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>
