---
import { getImage } from "astro:assets";

import Logo from "../components/Logo.astro";
import { LOCALES, captureLocale, messagesFor } from "../i18n";
import { GITHUB_OWNER_URL, LICENSE_URL, SITE_URL, STRUCTURE_URL, UMBRELLA_URL } from "../lib/site";
import { HERO_SHOTS } from "../lib/shots";
import "../styles/global.css";

import type { Locale } from "../i18n";

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { locale, noindex = false } = Astro.props;
const t = messagesFor(locale);
const languages = LOCALES.map((entry) => ({ ...entry, messages: messagesFor(entry.code) }));
const title = Astro.props.title ?? t.meta.title;
const description = Astro.props.description ?? t.meta.description;
const canonical = new URL(t.path, SITE_URL).href;
const social = await getImage({ src: HERO_SHOTS[captureLocale(locale)].wide.dark, width: 1200, format: "png" });
const socialUrl = new URL(social.src, SITE_URL).href;
const home = t.path;
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0b0e0d" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f6f9f8" media="(prefers-color-scheme: light)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {!noindex && languages.map((entry) => <link rel="alternate" hreflang={entry.messages.htmlLang} href={new URL(entry.messages.path, SITE_URL).href} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL("/", SITE_URL).href} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BMO" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialUrl} />
    <meta property="og:locale" content={{ en: "en_US", ko: "ko_KR", ja: "ja_JP", zh: "zh_CN" }[locale]} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">{t.nav.skip}</a>
    <header class="nav">
      <div class="container nav-inner">
        <a class="brand" href={home} aria-label={t.nav.home}>
          <Logo size={28} />
          <span>BMO</span>
        </a>
        <nav class="nav-links" aria-label="Primary">
          <a href={`${home}#new`}>{t.nav.whatsNew}</a>
          <a href={`${home}#features`}>{t.nav.features}</a>
          <a href={`${home}#compare`}>{t.nav.compare}</a>
          <a href={`${home}#how`}>{t.nav.how}</a>
          <a href={`${home}#download`}>{t.nav.download}</a>
          <a href={`${home}#repositories`}>{t.nav.repositories}</a>
          <a href={STRUCTURE_URL}>{t.nav.docs}</a>
        </nav>
        <div class="nav-end">
          <details class="lang-menu">
            <summary class="lang" aria-label={t.nav.language}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z" /></svg>
              <span>{languages.find((entry) => entry.code === locale)!.name}</span>
            </summary>
            <ul class="lang-list">
              {
                languages.map((entry) => (
                  <li>
                    <a
                      href={entry.messages.path}
                      hreflang={entry.messages.htmlLang}
                      lang={entry.messages.htmlLang}
                      aria-current={entry.code === locale ? "page" : undefined}
                    >
                      {entry.name}
                    </a>
                  </li>
                ))
              }
            </ul>
          </details>
          <a class="nav-github" href={UMBRELLA_URL} aria-label={t.nav.github}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.93c.58.1.79-.25.79-.56v-2c-3.2.69-3.88-1.37-3.88-1.37-.52-1.33-1.27-1.69-1.27-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.68 1.25 3.33.96.1-.75.4-1.25.72-1.54-2.55-.29-5.24-1.27-5.24-5.67 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.15 1.18a10.96 10.96 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.57.23 2.73.11 3.02.74.8 1.18 1.83 1.18 3.08 0 4.41-2.7 5.38-5.27 5.66.41.36.78 1.06.78 2.13v3.16c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z" />
            </svg>
          </a>
        </div>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="footer">
      <div class="container footer-inner">
        <div class="footer-brand">
          <Logo size={22} />
          <span>BMO</span>
        </div>
        <p class="footer-legal">
          <a href={LICENSE_URL}>{t.footer.license}</a> · {t.footer.copyright}
        </p>
        <nav class="footer-links" aria-label="Footer">
          <a href={UMBRELLA_URL}>GitHub</a>
          <a href={GITHUB_OWNER_URL}>{t.nav.repositories}</a>
          <a href={STRUCTURE_URL}>{t.footer.structure}</a>
          <a href={LICENSE_URL}>{t.footer.licenseLink}</a>
          {
            languages
              .filter((entry) => entry.code !== locale)
              .map((entry) => (
                <a href={entry.messages.path} hreflang={entry.messages.htmlLang} lang={entry.messages.htmlLang}>
                  {entry.name}
                </a>
              ))
          }
        </nav>
      </div>
    </footer>
    <script is:inline>
      // Closes the language menu on Escape and on a press outside it; the menu works without this.
      (function () {
        var menu = document.querySelector(".lang-menu");
        if (!menu) return;
        document.addEventListener("keydown", function (event) {
          if (event.key === "Escape" && menu.open) {
            menu.open = false;
            menu.querySelector("summary").focus();
          }
        });
        document.addEventListener("click", function (event) {
          if (menu.open && !menu.contains(event.target)) menu.open = false;
        });
      })();
    </script>
  </body>
</html>
