---
import { getImage } from "astro:assets";

import Logo from "../components/Logo.astro";
import { messagesFor, otherLocale } from "../i18n";
import { GITHUB_OWNER_URL, LICENSE_URL, SITE_URL, STRUCTURE_URL, UMBRELLA_URL } from "../lib/site";
import socialShot from "../assets/shots/console-room.webp";
import "../styles/global.css";

import type { Locale } from "../i18n";

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { locale, noindex = false } = Astro.props;
const t = messagesFor(locale);
const other = messagesFor(otherLocale(locale));
const title = Astro.props.title ?? t.meta.title;
const description = Astro.props.description ?? t.meta.description;
const canonical = new URL(t.path, SITE_URL).href;
const social = await getImage({ src: socialShot, width: 1200, format: "png" });
const socialUrl = new URL(social.src, SITE_URL).href;
const home = t.path;
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0e0d" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {!noindex && <link rel="alternate" hreflang="en" href={new URL("/", SITE_URL).href} />}
    {!noindex && <link rel="alternate" hreflang="ko" href={new URL("/ko/", SITE_URL).href} />}
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL("/", SITE_URL).href} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BMO" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialUrl} />
    <meta property="og:locale" content={locale === "ko" ? "ko_KR" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">{t.nav.skip}</a>
    <header class="nav">
      <div class="container nav-inner">
        <a class="brand" href={home} aria-label={t.nav.home}>
          <Logo size={28} />
          <span>BMO</span>
        </a>
        <nav class="nav-links" aria-label="Primary">
          <a href={`${home}#features`}>{t.nav.features}</a>
          <a href={`${home}#how`}>{t.nav.how}</a>
          <a href={`${home}#download`}>{t.nav.download}</a>
          <a href={`${home}#repositories`}>{t.nav.repositories}</a>
          <a href={STRUCTURE_URL}>{t.nav.docs}</a>
        </nav>
        <div class="nav-end">
          <a class="lang" href={other.path} hreflang={other.htmlLang} lang={other.htmlLang} aria-label={t.nav.otherLanguageLabel}>
            {t.nav.otherLanguage}
          </a>
          <a class="nav-github" href={UMBRELLA_URL} aria-label={t.nav.github}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.93c.58.1.79-.25.79-.56v-2c-3.2.69-3.88-1.37-3.88-1.37-.52-1.33-1.27-1.69-1.27-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.68 1.25 3.33.96.1-.75.4-1.25.72-1.54-2.55-.29-5.24-1.27-5.24-5.67 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.15 1.18a10.96 10.96 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.57.23 2.73.11 3.02.74.8 1.18 1.83 1.18 3.08 0 4.41-2.7 5.38-5.27 5.66.41.36.78 1.06.78 2.13v3.16c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z" />
            </svg>
          </a>
        </div>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="footer">
      <div class="container footer-inner">
        <div class="footer-brand">
          <Logo size={22} />
          <span>BMO</span>
        </div>
        <p class="footer-legal">
          <a href={LICENSE_URL}>{t.footer.license}</a> · {t.footer.copyright}
        </p>
        <nav class="footer-links" aria-label="Footer">
          <a href={UMBRELLA_URL}>GitHub</a>
          <a href={GITHUB_OWNER_URL}>{t.nav.repositories}</a>
          <a href={STRUCTURE_URL}>{t.footer.structure}</a>
          <a href={LICENSE_URL}>{t.footer.licenseLink}</a>
          <a href={other.path} hreflang={other.htmlLang} lang={other.htmlLang}>{t.nav.otherLanguage}</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
